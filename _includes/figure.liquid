{%- comment -%}
  Usage: {% include figure.liquid path="assets/img/x.png" alt="..." caption="..." zoomable=true %}
{%- endcomment -%}
<figure class="figure">
  <img src="{{ include.path | relative_url }}" alt="{{ include.alt | default: include.caption | default: '' | escape }}" loading="{{ include.loading | default: 'lazy' }}" decoding="async"{% if include.zoomable %} data-zoomable{% endif %}>
  {%- if include.caption %}<figcaption>{{ include.caption }}</figcaption>{% endif %}
</figure>
